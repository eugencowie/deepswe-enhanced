{
  "name": "deepswe-enhanced",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "build": "vp build",
    "validate": "vp build && vp check && vp test && vp run e2e && vp run deploy:dry-run",
    "validate:fix": "vp check --fix && vp run validate",
    "e2e": "playwright test",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "vp run deploy --dry-run",
    "deploy:preview": "wrangler preview",
    "refresh": "vp run refresh:deepswe && vp run refresh:openrouter",
    "refresh:deepswe": "node scripts/refresh-deepswe.ts",
    "refresh:openrouter": "node scripts/refresh-openrouter.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/browser-chromium": "1.63.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "shadcn": "4.21.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.145.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  }
}
